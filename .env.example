# kayla-frontend configuration — agents.md §7.4.
# Copy to .env.local and fill in. Never put a real secret in a NEXT_PUBLIC_* var:
# they are inlined into the JavaScript bundle and are readable by anyone (§7.5, R6).
# Every variable below is required. src/env.ts fails the build loudly if one is missing.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development
